    "cadence": "Daily",
    "probes": [
      {
        "url": "https://coolcode.ca/distropilot/data/status.json",
        "path": [
          "checked_at"
        ],
        "precision": "minute",
        "label": "Package and lifecycle sources checked",
        "count_at": {
          "path": [
            "count"
          ],
          "unit": "projects"
        }
      }
    ]
  }
